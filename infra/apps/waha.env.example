# Salin jadi `waha.env` di /srv/hammielion/ di VPS. Jangan pernah di-commit.

# Kunci API WAHA. Nilai yang sama harus diisi ke WAHA_API_KEY di order-web.env.
# Buat acak, jangan diketik sendiri:
#   openssl rand -hex 24
WAHA_API_KEY=

# Nama sesi WhatsApp. Harus sama dengan WAHA_SESSION di order-web.env.
WHATSAPP_DEFAULT_ENGINE=WEBJS
