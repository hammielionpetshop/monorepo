# Caddy mengurus sertifikat Let's Encrypt sendiri; tidak ada certbot/cron.
# Syaratnya A record kedua domain sudah menunjuk ke VPS ini dan port 80 terbuka.

{
	email {$ACME_EMAIL}
}

# Dibuat hanya setelah staging siap dan dilindungi kata sandi.
# Glob kosong tetap valid; /data adalah volume Caddy yang bertahan saat deploy.
import /data/staging-sites*.caddy

{$DOMAIN_BACKOFFICE} {
	encode zstd gzip

	@jobs path /api/jobs /api/jobs/*
	respond @jobs 404

	# Berkas upload ditulis saat runtime ke volume bersama. public/ Next hanya
	# menyajikan berkas yang sudah ada saat build, jadi jalur ini sengaja tidak
	# lewat Next sama sekali.
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	handle {
		reverse_proxy backoffice:3000
	}

	# Caddy mengirim X-Forwarded-Proto secara otomatis, yang dibutuhkan Next agar
	# cookie Secure dan redirect tetap benar di belakang proxy.

	log {
		output file /data/log/backoffice.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

{$DOMAIN_ORDER_WEB} {
	encode zstd gzip

	@jobs path /api/jobs /api/jobs/*
	respond @jobs 404

	reverse_proxy order-web:3000

	log {
		output file /data/log/order-web.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
