# Salin jadi `order-web.env` di /srv/hammielion/ di VPS. Jangan pernah di-commit.

# Sama seperti backoffice: PgBouncer di VPS lama, sslmode=require.
DATABASE_URL=postgres://user:sandi@ip-vps-lama:6432/petshop_db?sslmode=require

# Kosongkan untuk memakai bawaan 10.
# DB_POOL_MAX=10

# Minimal 32 karakter. Mengganti nilainya memaksa semua pelanggan login ulang.
CUSTOMER_JWT_SECRET=

# Cabang yang katalog & stoknya dipakai portal pelanggan.
ORDER_BRANCH_ID=2

# Nilai minimum satu pesanan, dalam rupiah (integer).
ORDER_MIN_AMOUNT=50000

# Pengiriman OTP. `console` hanya mencetak kode ke log — jangan dipakai di produksi.
# Pilihan: console | fonnte | waha
OTP_PROVIDER=waha
OTP_TTL_SECONDS=300

# WAHA masih di VPS lama; kalau diakses lewat jaringan publik, pakai https.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# Hanya perlu bila OTP_PROVIDER=fonnte.
# FONNTE_TOKEN=
