# Salin jadi `.env` di /srv/hammielion/ di VPS.
#
# Berkas ini HANYA untuk docker compose sendiri (nama image, domain) — bukan untuk
# app. Rahasia app ada di backoffice.env dan order-web.env.

# Pemilik repo di GHCR, huruf kecil semua.
GHCR_OWNER=hammielionpetshop

# Tag image yang sedang jalan. Diisi otomatis oleh workflow deploy (SHA commit);
# isi manual dengan SHA lama untuk rollback cepat tanpa build ulang.
IMAGE_TAG=latest

# Domain produksi. Harus sudah menunjuk ke IP VPS ini sebelum Caddy bisa
# menerbitkan sertifikat.
DOMAIN_BACKOFFICE=admin.contoh.com
DOMAIN_ORDER_WEB=order.contoh.com

# Alamat email untuk pendaftaran Let's Encrypt (pemberitahuan kedaluwarsa).
ACME_EMAIL=admin@contoh.com

# Hanya diisi saat profil hris akan dinyalakan. Jangan gunakan role admin.
HRIS_DATABASE_URL=
JOB_SECRET=

# Auth pusat backoffice (HRIS L1c). Biarkan kosong/legacy sampai cutover disetujui owner.
# Mode central butuh semua nilai di bawah; app menolak jalan bila ada yang kurang.
# BO_AUTH_MODE=legacy            # legacy | central
# BO_AUTH_BRIDGE_UNTIL=          # opsional, waktu ISO (mis. 2026-11-20T00:00:00+07:00), maks 7 hari ke depan;
#                                # selama belum lewat, token backoffice lama tetap diterima pada mode central
# AUTH_COOKIE_ENV=               # local | staging | production
# AUTH_COOKIE_DOMAIN=            # domain induk, wajib bila bukan local
# AUTH_CSRF_SECRET=              # minimal 32 karakter
# AUTH_TRUSTED_ORIGINS=          # daftar origin dipisah koma
# AUTH_DATABASE_URL=             # opsional; bawaan DATABASE_URL

# Pintu provisioning internal HRIS → backoffice (L1d). Hanya berlaku pada mode central.
# Host harus nama internal (mis. backoffice:3000), bukan domain publik; Caddy memblokir /api/internal.
# HRIS_INTERNAL_KEY=             # minimal 32 karakter, sama di HRIS dan backoffice
# INTERNAL_ALLOWED_HOSTS=        # daftar host internal dipisah koma
