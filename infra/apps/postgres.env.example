# Salin jadi `postgres.env` di /srv/hammielion/ di VPS. Jangan pernah di-commit.
#
# Pakai user dan nama database yang SAMA PERSIS dengan server lama. Dengan begitu
# perpindahan hanya mengubah bagian host di DATABASE_URL, bukan kredensialnya —
# lebih sedikit yang bisa salah, dan rollback tinggal menukar host kembali.

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=petshop_db

# Zona waktu container. Aplikasi sudah memaksa UTC lewat connection string
# (lihat createDb di packages/db), ini sekadar menyamakan log.
TZ=UTC
