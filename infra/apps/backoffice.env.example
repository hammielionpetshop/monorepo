# Salin jadi `backoffice.env` di /srv/hammielion/ di VPS. Jangan pernah di-commit.

# Postgres masih di VPS lama dan tidak ada private network, jadi koneksi ini
# melintasi internet publik. Tiga hal wajib, semuanya saling bergantung:
#
#   1. Arahkan ke PgBouncer (:6432), bukan Postgres langsung (:5432).
#   2. sslmode=verify-full, BUKAN require. Di postgres.js `require` menyetel
#      rejectUnauthorized=false — terenkripsi tapi server tidak diautentikasi,
#      jadi tetap bisa disadap lewat MITM. Hanya verify-full yang memeriksa
#      sertifikat sampai ke CA.
#   3. HOSTNAME, bukan IP. postgres.js hanya mengisi TLS servername kalau host
#      bukan alamat IP; dengan IP, verifikasi nama host tidak pernah terjadi.
#
# Sertifikatnya harus tepercaya publik (Let's Encrypt) untuk hostname ini —
# lihat docs/work/specs/2026-08-14-migrasi-deployment-vps.md §4.
DATABASE_URL=postgres://user:sandi@server.contoh.com:6432/petshop_db?sslmode=verify-full

# Batas koneksi pool proses ini. Kosongkan untuk memakai bawaan 10.
# backoffice + order-web berbagi max_connections = 40 di server DB.
# DB_POOL_MAX=10

# Minimal 32 karakter. Mengganti nilainya memaksa semua user login ulang.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Folder upload di dalam container; sudah diarahkan ke volume oleh
# docker-compose.yml, jadi biasanya tidak perlu diisi di sini.
# UPLOAD_DIR=/data/uploads

# Akses ke gateway WhatsApp, untuk halaman Pengaturan → WhatsApp (tautkan/putus
# nomor pengirim OTP). Nilainya harus sama dengan yang ada di order-web.env.
# WAHA tidak terbuka ke internet; `waha` adalah nama service di jaringan compose.
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

# QZ Tray — tanda tangan request cetak. Kosongkan = mode anonim: cetak tetap jalan
# tapi QZ Tray memunculkan dialog izin tiap sesi. Isi keduanya agar dialog hilang.
#
# Buat nilainya sekali: `node scripts/qz-gen-cert.mjs` (butuh openssl). Skrip mencetak
# dua baris siap tempel. Newline PEM sebagai \n literal, dalam tanda kutip.
# Setelah diisi, di TIAP PC pencetak: salin qz-digital-certificate.txt ke
# `C:\Program Files\QZ Tray\override.crt` lalu restart QZ Tray.
QZ_PRIVATE_KEY=
QZ_CERTIFICATE=
