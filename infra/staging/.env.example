# Salin menjadi /srv/hammielion-staging/.env, mode 600. Gunakan rahasia staging baru.
GHCR_OWNER=hammielionpetshop
# Wajib staging-<SHA 40 karakter>; diisi pipeline setelah deploy sehat.
STAGING_IMAGE_TAG=staging-0000000000000000000000000000000000000000
STAGING_BACKOFFICE_DATABASE_URL=postgresql://stg_bo_app:GANTI_PASSWORD@postgres:5432/petshop_staging
STAGING_ORDER_DATABASE_URL=postgresql://stg_order_app:GANTI_PASSWORD@postgres:5432/petshop_staging
STAGING_HRIS_DATABASE_URL=postgresql://stg_hris_app:GANTI_PASSWORD@postgres:5432/petshop_staging
# Web Finance staging (F2-6): role baca saja.
STAGING_FINANCE_DATABASE_URL=postgresql://stg_finance_app:GANTI_PASSWORD@postgres:5432/petshop_staging
STAGING_JOB_SECRET=GANTI_DENGAN_RAHASIA_STAGING_BARU
# Di VPS cron disalin ke folder ini; saat menjalankan compose dari repo gunakan ../apps/cron.
STAGING_CRON_DIR=./cron
DOMAIN_STAGING_BACKOFFICE=bo.staginghml.my.id
DOMAIN_STAGING_HRIS=hris.staginghml.my.id
DOMAIN_STAGING_ORDER_WEB=order.staginghml.my.id
DOMAIN_STAGING_FINANCE=finance.staginghml.my.id
STAGING_BASIC_AUTH_USER=owner
# Hash bcrypt dari `caddy hash-password`; bungkus petik tunggal agar $ tidak diinterpolasi Compose.
STAGING_BASIC_AUTH_HASH='GANTI_HASH_BCRYPT'
# Kunci uji banding HRIS L9b (spec L9 §4): isi 1 selama data salinan sistem lama ada di staging, lalu kembalikan 0.
STAGING_HRIS_RESTRICT=0
