# Database
DATABASE_URL=postgresql://user:password@localhost:5432/petshop_db

# Auth
JWT_SECRET=generate_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=generate_another_random_string_of_at_least_32_characters

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# QZ Tray — tanda tangan request cetak (opsional). Kosongkan = mode anonim: cetak
# tetap jalan tapi QZ Tray menampilkan dialog izin. Isi keduanya agar dialog hilang.
# Buat nilainya sekali dengan: node scripts/qz-gen-cert.mjs
# Newline PEM ditulis sebagai \n literal, dalam tanda kutip.
QZ_PRIVATE_KEY=
QZ_CERTIFICATE=
