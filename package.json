{
  "name": "hammielion-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:pos": "turbo dev --filter petshop-pos",
    "dev:backoffice": "turbo dev --filter backoffice",
    "db:migrate": "pnpm --filter @petshop/db db:migrate",
    "db:push": "pnpm --filter @petshop/db db:push",
    "db:studio": "pnpm --filter @petshop/db db:studio",
    "db:seed": "pnpm --filter @petshop/db db:seed",
    "db:local:up": "docker compose up -d --wait",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && pnpm db:local:up && pnpm db:local:setup",
    "db:local:migrate": "node scripts/with-local-db.mjs pnpm --filter @petshop/db db:migrate",
    "db:local:clone": "node scripts/with-local-db.mjs pnpm --filter @petshop/db db:clone-master",
    "db:local:seed": "node scripts/with-local-db.mjs pnpm --filter @petshop/db db:seed-local",
    "db:local:setup": "pnpm db:local:migrate && pnpm db:local:clone && pnpm db:local:seed",
    "db:local:studio": "node scripts/with-local-db.mjs pnpm --filter @petshop/db db:studio",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "^8.48.0",
      "@typescript-eslint/parser": "^8.48.0"
    }
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.9"
}
